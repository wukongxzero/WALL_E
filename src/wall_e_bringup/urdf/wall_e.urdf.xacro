<?xml version="1.0"?>
<robot name="wall_e" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── PROPERTIES ── -->
  <xacro:property name="base_length"   value="0.365"/>  <!-- 8.5 inches -->
  <xacro:property name="base_width"    value="0.390"/>   <!-- 46cm total -->
  <xacro:property name="base_height"   value="0.245"/>   <!-- 56cm -->
  <xacro:property name="track_width"   value="0.46"/>   <!-- sim only: places wheels outside body -->
  <xacro:property name="track_thick"   value="0.07"/>   <!-- 7cm track thickness -->
  <xacro:property name="wheel_radius"  value="0.08"/>   <!-- 8cm radius -->

  <xacro:property name="cam_height"    value="0.245"/>   <!-- 20cm off ground -->
  <xacro:property name="cam_forward"   value="0.15"/>  <!-- 14.7cm forward of center -->
  <!-- <xacro:property name="pi"            value="3.141592653  58979"/> -->

  <!-- ── BASE FOOTPRINT ── -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_height/2 + wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ── BASE LINK ── -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${-base_height/4}" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.1414" ixy="0" ixz="0"
               iyy="0.1288" iyz="0"
               izz="0.1902"/>
    </inertial>
  </link>

  <!-- ── LEFT TRACK ── -->
  <link name="left_track">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${track_thick}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${track_thick}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001004" ixy="0" ixz="0"
               iyy="0.001600" iyz="0"
               izz="0.001004"/>
    </inertial>
  </link>

  <joint name="left_track_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="left_track"/>
    <origin xyz="0 ${track_width/2} ${-base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ── RIGHT TRACK ── -->
  <link name="right_track">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${track_thick}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${track_thick}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001004" ixy="0" ixz="0"
               iyy="0.001600" iyz="0"
               izz="0.001004"/>
    </inertial>
  </link>

  <joint name="right_track_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="right_track"/>
    <origin xyz="0 ${-track_width/2} ${-base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ── D435 CAMERA ── -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${cam_forward} 0 ${cam_height - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Camera optical frame — required by RealSense driver -->
  <link name="camera_depth_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_color_optical_frame"/>

  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ── IMU ── -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ── GAZEBO PLUGINS ── -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_track_joint</left_joint>
      <right_joint>right_track_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  <!-- Make base_link visible in Gazebo -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="left_track">
    <material>Gazebo/Black</material>
    <collision>
      <surface>
        <friction>
          <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
        </friction>
        <contact>
          <ode><kp>1e6</kp><kd>100.0</kd><min_depth>0.001</min_depth></ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="right_track">
    <material>Gazebo/Black</material>
    <collision>
      <surface>
        <friction>
          <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
        </friction>
        <contact>
          <ode><kp>1e6</kp><kd>100.0</kd><min_depth>0.001</min_depth></ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- ── PASSIVE SUPPORT SPHERES (pitch stability + free turning) ── -->
  <xacro:macro name="support_wheel" params="name x_pos y_pos">
    <link name="${name}">
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.00001" ixy="0" ixz="0"
                 iyy="0.00001" iyz="0"
                 izz="0.00001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="${x_pos} ${y_pos} ${-base_height/2}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}">
      <collision>
        <surface>
          <friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:support_wheel name="left_front_support"  x_pos="${base_length/2 - wheel_radius}" y_pos="${track_width/2}"/>
  <xacro:support_wheel name="left_rear_support"   x_pos="${-(base_length/2 - wheel_radius)}" y_pos="${track_width/2}"/>
  <xacro:support_wheel name="right_front_support" x_pos="${base_length/2 - wheel_radius}" y_pos="${-track_width/2}"/>
  <xacro:support_wheel name="right_rear_support"  x_pos="${-(base_length/2 - wheel_radius)}" y_pos="${-track_width/2}"/>

  <gazebo reference="camera_link">
    <material>Gazebo/Blue</material>
    <sensor name="rgbd_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.3</near>
          <far>4.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>5</update_rate>
      <topic>/wall_e/camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>