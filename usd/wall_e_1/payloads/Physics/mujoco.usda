#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "wall_e"
    doc = """Generated from Composed Stage of root layer /tmp/tmpte7cmjxb/wall_e.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_wall_e_upxqnbea/usdex_wall_e/wall_e.usdc


