#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "blue_shark_land_vehicle"
    doc = """Generated from Composed Stage of root layer /tmp/tmpvzquxdhh/blue_shark_land_vehicle.usdc


