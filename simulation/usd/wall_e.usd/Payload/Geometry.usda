        def Scope "custom"
        {
            def Scope "gazebo"
            {
                def Scope "plugin"
                {
                    custom string urdf:filename = "gz-sim-diff-drive-system"
                    custom string urdf:name = "gz::sim::systems::DiffDrive"

                    def Scope "left_joint"
                    {
                        custom string urdf:text = "left_track_joint"
                    }

                    def Scope "right_joint"
                    {
                        custom string urdf:text = "right_track_joint"
                    }

                    def Scope "wheel_separation"
                    {
                        custom string urdf:text = "0.46"
                    }

                    def Scope "wheel_radius"
                    {
                        custom string urdf:text = "0.08"
                    }

                    def Scope "odom_publish_frequency"
                    {
                        custom string urdf:text = "30"
                    }

                    def Scope "topic"
                    {
                        custom string urdf:text = "/cmd_vel"
                    }

                    def Scope "odom_topic"
                    {
                        custom string urdf:text = "/odom"
                    }

                    def Scope "frame_id"
