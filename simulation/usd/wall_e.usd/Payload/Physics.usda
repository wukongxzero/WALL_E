#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    defaultPrim = "wall_e"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "wall_e"
{
    def Scope "Physics"
    {
        # base_link (below) already carries PhysicsArticulationRootAPI, which
        # makes it a free 6-DOF floating base by default — no joint to world
        # needed. There used to be a base_footprint_joint here fixing
        # base_link to </wall_e>, but </wall_e> has no PhysicsRigidBodyAPI,
        # so USD Physics treated that side as the static world frame and
        # welded the whole robot in place. The (0,0,0.2025) offset it
        # provided is redundant anyway — base_link's own xformOp:translate
        # in Geometry.usda already has it.

        def PhysicsRevoluteJoint "left_track_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/left_track>
            point3f physics:localPos0 = (0, 0.23, -0.1225)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:dynamics:damping = 0.5
            custom float urdf:dynamics:friction = 0.5
            # Gazebo's DiffDrive plugin actuated this joint directly with no
            # URDF transmission/actuator to convert, so the USD import brought
            # in a passive hinge. IsaacArticulationController needs a velocity
            # drive to have anything to command — stiffness 0 + damping makes
            # it a pure velocity servo (target set live by the OmniGraph).
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:maxForce = 100000
        }

        def PhysicsRevoluteJoint "right_track_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/right_track>
            point3f physics:localPos0 = (0, -0.23, -0.1225)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:dynamics:damping = 0.5
            custom float urdf:dynamics:friction = 0.5
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:maxForce = 100000
        }

        def PhysicsFixedJoint "camera_joint"
        {
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/camera_link>
            point3f physics:localPos0 = (0.15, 0, 0.165)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "camera_optical_joint"
        {
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/camera_link/camera_depth_optical_frame>
            point3f physics:localPos0 = (0.15, 0, 0.165)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.5, -0.5, 0.5, -0.5)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "camera_color_optical_joint"
        {
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/camera_link/camera_color_optical_frame>
            point3f physics:localPos0 = (0.15, 0, 0.165)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.5, -0.5, 0.5, -0.5)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "imu_joint"
        {
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/imu_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "left_front_support_joint"
        {
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/left_front_support>
            point3f physics:localPos0 = (0.1025, 0.23, -0.1225)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "left_rear_support_joint"
        {
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/left_rear_support>
            point3f physics:localPos0 = (-0.1025, 0.23, -0.1225)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "right_front_support_joint"
        {
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/right_front_support>
            point3f physics:localPos0 = (0.1025, -0.23, -0.1225)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "right_rear_support_joint"
        {
            rel physics:body0 = </wall_e/Geometry/base_footprint/base_link>
            rel physics:body1 = </wall_e/Geometry/base_footprint/base_link/right_rear_support>
            point3f physics:localPos0 = (-0.1025, -0.23, -0.1225)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, -0.06125)
                float3 physics:diagonalInertia = (0.1288, 0.1414, 0.1902)
                float physics:mass = 8
                quatf physics:principalAxes = (6.123234e-17, 0.70710677, 0.70710677, 0)

                over "box_1" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
                }

                over "left_track" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    float3 physics:diagonalInertia = (0.001004, 0.001004, 0.0016)
                    float physics:mass = 0.5
                    quatf physics:principalAxes = (0.70710677, 0.70710677, 0, 0)

                    over "cylinder_1" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "right_track" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    float3 physics:diagonalInertia = (0.001004, 0.001004, 0.0016)
                    float physics:mass = 0.5
                    quatf physics:principalAxes = (0.70710677, 0.70710677, 0, 0)

                    over "cylinder_1" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "camera_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
                    float physics:mass = 0.001
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "box_1" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                    )
                    {
                    }

                    over "camera_depth_optical_frame" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                    }

                    over "camera_color_optical_frame" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                    }
                }

                over "imu_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                }

                over "left_front_support" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
                    float physics:mass = 0.01
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "sphere" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "left_rear_support" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
                    float physics:mass = 0.01
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "sphere" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "right_front_support" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
                    float physics:mass = 0.01
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "sphere" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                    )
                    {
                    }
                }

                over "right_rear_support" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
                    float physics:mass = 0.01
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "sphere" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                    )
                    {
                    }
                }
            }
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI"]
)
{
}

