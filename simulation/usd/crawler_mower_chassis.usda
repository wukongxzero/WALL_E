#usda 1.0
(
    defaultPrim = "Crawler_Mower_Chassis"
    metersPerUnit = 1.0
    kilogramsPerUnit = 1.0
    upAxis = "Z"
)

def Xform "Crawler_Mower_Chassis"
{
    # =========================================================
    # 1. MAIN CHASSIS BODY (Heavy Steel Frame & Battery Enclosure)
    # Dimensions: 0.8m L x 0.5m W x 0.2m H | Mass: 85.0 kg
    # =========================================================
    def Cube "Base_Chassis" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0.0, 0.0, 0.20)
        double3 xformOp:scale = (0.40, 0.25, 0.10)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.8, 0.1, 0.1)]

        # Rigid Body & Collision Flags
        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        bool physics:collisionEnabled = true

        # Mass & Inertia Tensor
        float physics:mass = 85.0
        point3f physics:centerOfMass = (0.0, 0.0, -0.08)
        float3 physics:diagonalInertia = (3.2, 5.0, 6.2)
        quatf physics:principalAxes = (1, 0, 0, 0)
    }

    # =========================================================
    # 2. LEFT RUBBER TRACK MODULE
    # Dimensions: 0.9m L x 0.15m W x 0.25m H | Mass: 20.0 kg
    # =========================================================
    def Cube "Left_Track" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0.0, 0.35, 0.125)
        double3 xformOp:scale = (0.45, 0.075, 0.125)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]

        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        bool physics:collisionEnabled = true

        float physics:mass = 20.0
        point3f physics:centerOfMass = (0.0, 0.0, 0.0)
        float3 physics:diagonalInertia = (0.14, 1.45, 1.40)
        quatf physics:principalAxes = (1, 0, 0, 0)
    }

    # =========================================================
    # 3. RIGHT RUBBER TRACK MODULE
    # Dimensions: 0.9m L x 0.15m W x 0.25m H | Mass: 20.0 kg
    # =========================================================
    def Cube "Right_Track" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0.0, -0.35, 0.125)
        double3 xformOp:scale = (0.45, 0.075, 0.125)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]

        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        bool physics:collisionEnabled = true

        float physics:mass = 20.0
        point3f physics:centerOfMass = (0.0, 0.0, 0.0)
        float3 physics:diagonalInertia = (0.14, 1.45, 1.40)
        quatf physics:principalAxes = (1, 0, 0, 0)
    }

    # =========================================================
    # 4. GAS ENGINE & CUTTING DECK ASSEMBLY
    # Cylinder Radius: 0.25m, Height: 0.15m | Mass: 22.0 kg
    # =========================================================
    def Cylinder "Engine_Cutting_Deck" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        token axis = "Z"
        double radius = 1.0
        double height = 1.0
        double3 xformOp:translate = (0.0, 0.0, 0.40)
        double3 xformOp:scale = (0.25, 0.25, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.3, 0.3, 0.3)]

        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        bool physics:collisionEnabled = true

        float physics:mass = 22.0
        point3f physics:centerOfMass = (0.0, 0.0, -0.02)
        float3 physics:diagonalInertia = (0.38, 0.38, 0.68)
        quatf physics:principalAxes = (1, 0, 0, 0)
    }

    # =========================================================
    # 5. LEFT DRIVE MOTOR & GEARBOX (24V/48V 500W-1000W DC)
    # Mass: 7.5 kg
    # =========================================================
    def Cylinder "Left_Motor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        token axis = "Y"
        double radius = 1.0
        double height = 1.0
        double3 xformOp:translate = (-0.30, 0.20, 0.15)
        double3 xformOp:scale = (0.05, 0.10, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]

        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        bool physics:collisionEnabled = true

        float physics:mass = 7.5
        point3f physics:centerOfMass = (0.0, 0.0, 0.0)
        float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
        quatf physics:principalAxes = (1, 0, 0, 0)
    }

    # =========================================================
    # 6. RIGHT DRIVE MOTOR & GEARBOX (24V/48V 500W-1000W DC)
    # Mass: 7.5 kg
    # =========================================================
    def Cylinder "Right_Motor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        token axis = "Y"
        double radius = 1.0
        double height = 1.0
        double3 xformOp:translate = (-0.30, -0.20, 0.15)
        double3 xformOp:scale = (0.05, 0.10, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]

        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        bool physics:collisionEnabled = true

        float physics:mass = 7.5
        point3f physics:centerOfMass = (0.0, 0.0, 0.0)
        float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
        quatf physics:principalAxes = (1, 0, 0, 0)
    }
}
