#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "wall_e"
    doc = """Generated from Composed Stage of root layer /tmp/tmp061bqoov/wall_e.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_wall_e_bmn9b9_v/usdex_wall_e/wall_e.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_wall_e_bmn9b9_v/temp_wall_e/wall_e.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "wall_e" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </wall_e/Physics/root_joint>,
        </wall_e/Physics/base_footprint_joint>,
        </wall_e/Physics/left_track_joint>,
        </wall_e/Physics/right_track_joint>,
        </wall_e/Physics/camera_joint>,
        </wall_e/Physics/left_front_support_joint>,
        </wall_e/Physics/left_rear_support_joint>,
        </wall_e/Physics/right_front_support_joint>,
        </wall_e/Physics/right_rear_support_joint>,
        </wall_e/Physics/camera_optical_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </wall_e/Geometry/base_footprint>,
        </wall_e/Geometry/base_footprint/base_link>,
        </wall_e/Geometry/base_footprint/base_link/left_track>,
        </wall_e/Geometry/base_footprint/base_link/right_track>,
        </wall_e/Geometry/base_footprint/base_link/camera_link>,
        </wall_e/Geometry/base_footprint/base_link/camera_link/camera_depth_optical_frame>,
        </wall_e/Geometry/base_footprint/base_link/left_front_support>,
        </wall_e/Geometry/base_footprint/base_link/left_rear_support>,
        </wall_e/Geometry/base_footprint/base_link/right_front_support>,
        </wall_e/Geometry/base_footprint/base_link/right_rear_support>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_footprint" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_track" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "right_track" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "camera_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "camera_depth_optical_frame" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }

                over "left_front_support" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "left_rear_support" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "right_front_support" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "right_rear_support" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_footprint_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_track_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_track_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_optical_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_front_support_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_rear_support_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_front_support_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_rear_support_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

